  "serial": 37,
  "lineage": "2f9e8340-4fdc-da4b-559b-c089145db1a4",
  "outputs": {
    "port_forward_commands": {
      "value": {
        "1_wp_multisite": "kubectl port-forward svc/multisite-svc   8080:80",
        "2_wordpress": "kubectl port-forward svc/wordpress-svc   8081:80",
        "3_nodejs": "kubectl port-forward svc/nodejs-svc      8082:3000",
        "4_debian_ssh": "kubectl port-forward svc/debian-vps-svc  2222:22"
      },
      "type": [
        "object",
        {
          "1_wp_multisite": "string",
          "2_wordpress": "string",
          "3_nodejs": "string",
          "4_debian_ssh": "string"
        }
      ]
    },
    "services": {
      "value": {
        "debian_vps": "ssh root@localhost -p 2222  (VPS Debian SSH)",
        "nodejs": "http://localhost:8082       (API Node.js)",
        "wordpress": "http://localhost:8081       (WordPress site unique + MySQL)",
        "wp_multisite": "http://localhost:8080       (WordPress Multisite — réseau de sites)"
      },
      "type": [
        "object",
        {
          "debian_vps": "string",
          "nodejs": "string",
          "wordpress": "string",
          "wp_multisite": "string"
        }
      ]
    },
    "wp_multisite_setup": {
      "value": "1. Ouvrir http://localhost:8080/wp-admin\n2. Aller dans Outils \u003e Configuration du réseau\n3. Choisir \"Sous-répertoires\" (subdirectory)\n4. Suivre les instructions pour activer le réseau\n5. Ajouter des sites via Mes Sites \u003e Administration réseau \u003e Sites\n",
      "type": "string"
    }
  },
  "resources": [
    {
      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "mysql_init",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": {},
            "data": {
              "init.sql": "CREATE DATABASE IF NOT EXISTS `wordpress_db`;\nCREATE DATABASE IF NOT EXISTS `wordpress_multisite_db`;\nCREATE USER IF NOT EXISTS 'wp_user'@'%' IDENTIFIED BY 'wp_secret_pass';\nGRANT ALL PRIVILEGES ON `wordpress_db`.* TO 'wp_user'@'%';\nGRANT ALL PRIVILEGES ON `wordpress_multisite_db`.* TO 'wp_user'@'%';\nFLUSH PRIVILEGES;\n"
            },
            "id": "default/mysql-init",
            "immutable": false,
            "metadata": [
              {
                "annotations": {},
                "generate_name": "",
                "generation": 0,
                "labels": {},
                "name": "mysql-init",
                "namespace": "default",
                "resource_version": "499",
                "uid": "c6d9ea65-7a59-4949-b70f-0a90e198a92c"
              }
            ]
          },
