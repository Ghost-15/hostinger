    {
      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "nodejs_app",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": {},
            "data": {
              "server.js": "const http = require('http');\nconst os   = require('os');\nconst server = http.createServer((req, res) =\u003e {\n  res.writeHead(200, { 'Content-Type': 'application/json' });\n  res.end(JSON.stringify({\n    status: 'OK',\n    service: 'Node.js Server',\n    hostname: os.hostname(),\n    timestamp: new Date().toISOString(),\n    path: req.url\n  }));\n});\nserver.listen(3000, () =\u003e console.log('Node.js running on port 3000'));\n"
            },
            "id": "default/nodejs-app",
            "immutable": false,
            "metadata": [
              {
                "annotations": {},
                "generate_name": "",
                "generation": 0,
                "labels": {},
                "name": "nodejs-app",
                "namespace": "default",
                "resource_version": "510",
                "uid": "357b3c8c-d8c4-43ab-bec8-955fbef90fbe"
              }
            ]
          },
